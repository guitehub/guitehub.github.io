{
  "name": "guitehub-github-io",
  "private": true,
  "description": "Outillage de développement du site (gueathub : validation des données, tests). Rien ici n'est publié.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/gueathub-check.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"outils/gueathub/js/domain/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"outils/gueathub/tests/**/*.test.js\"",
    "css:build": "tailwindcss -i outils/gueathub/src/app.css -o outils/gueathub/app.css --minify",
    "css:watch": "tailwindcss -i outils/gueathub/src/app.css -o outils/gueathub/app.css --watch",
    "icons": "node scripts/gueathub-icons.mjs",
    "pwa-icons": "node scripts/gueathub-pwa-icons.mjs",
    "photos": "node scripts/gueathub-photos.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "ajv": "^8.20.0",
    "bootstrap-icons": "^1.13.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
