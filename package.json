{
  "name": "guitehub-github-io",
  "private": true,
  "description": "Outillage de développement du site (gueathub : validation des données, tests). Rien ici n'est publié.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/gueathub-check.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"outils/gueathub/js/domain/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"outils/gueathub/tests/**/*.test.js\""
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
